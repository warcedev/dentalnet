APP_NAME=DentalWeb
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/Asuncion

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=wal
DB_SYNCHRONOUS=normal
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-responder@consultorio.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- DentalWeb ---
# Exigir 2FA a los administradores (recomendado: true en producción)
CLINIC_REQUIRE_ADMIN_2FA=true
# Meses entre limpiezas (para calcular la próxima recomendada)
CLINIC_CLEANING_INTERVAL_MONTHS=6
# Respaldos: carpeta destino y cantidad de días a conservar
BACKUP_PATH=storage/app/backups
BACKUP_KEEP_DAYS=30
# Contraseña para cifrar los .zip de respaldo (guárdela fuera del servidor)
BACKUP_PASSWORD=

# Datos del consultorio (aparecen en los recordatorios)
CLINIC_ADDRESS=
CLINIC_PHONE=

# Tamaño máximo de documentos clínicos (KB)
DOCUMENTS_MAX_KB=15360

# Agenda: horario de atención, días hábiles (1 = lunes … 7 = domingo) y grilla en minutos
AGENDA_OPENS_AT=07:00
AGENDA_CLOSES_AT=20:00
AGENDA_WORKING_DAYS=1,2,3,4,5,6
AGENDA_SLOT_MINUTES=15

# Recordatorios (canal: email; whatsapp y sms quedan preparados pero sin proveedor)
REMINDERS_CHANNEL=email
REMINDERS_UPCOMING_DAYS=3
REMINDERS_CONFIRMATION_HOURS=24
REMINDERS_CLEANING_DAYS=7
REMINDERS_CONTROL_DAYS=30
REMINDERS_WARRANTY_DAYS=30
REMINDERS_SEND_HOUR=9
REMINDERS_MAX_ATTEMPTS=3
